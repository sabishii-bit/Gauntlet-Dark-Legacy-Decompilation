{
  "name": "gdl-reconstruction-tools",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "lint": "node .vscode/lint/fakematch_lint.cjs",
    "lint:install": "cargo install --path tools/fakematch-linter --locked --root tools/fakematch-lint",
    "lint:ast": "node .vscode/lint/fakematch_lint.cjs --rule FM001 --rule FM002 --rule FM005 --rule FM006",
    "lint:decomp": "node .vscode/lint/fakematch_lint.cjs --fail-on-findings --out build/fakematch_lint.json",
    "lint:editor": "node .vscode/lint/fakematch_lint.cjs --format problems --watch",
    "lint:explain": "node .vscode/lint/fakematch_lint.cjs --explain",
    "lint:rules": "node .vscode/lint/fakematch_lint.cjs --list-rules",
    "lint:test": "cargo test --locked --manifest-path tools/fakematch-linter/Cargo.toml"
  }
}
