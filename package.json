{
  "name": "gdl-reconstruction-tools",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "lint:ast": "ast-grep scan --config sgconfig.yml --filter ^FM00[1256]$ src include",
    "test:lint": "ast-grep test --config sgconfig.yml --skip-snapshot-tests",
    "lint:decomp": "python tools/gdl/fakematch_lint.py --out build/fakematch_lint.json",
    "test:lint:integration": "python -m unittest tools.gdl.tests.test_fakematch_lint -b"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3"
  }
}
